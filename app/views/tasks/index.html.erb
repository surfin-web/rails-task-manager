<h1>My tasks</h1>

<ul class="list-unstyled">
  <% @tasks.each do |task| %>
    <li>
      <% if task.completed %>
        <i class="fa-regular fa-square-check"></i>
      <% else %>
        <i class="fa-regular fa-square"></i>
      <% end %>

      <%= link_to task.title, task_path(task), class: "text-decoration-none" %>

      <%= link_to task_path(task), class: "text-decoration-none text-danger", data: { turbo_method: :delete, turbo_confirm: "Delete #{task.title}?" } do %>
        <i class="fa-solid fa-trash"></i>
      <% end %>
    </li>
  <% end %>
</ul>

<hr>

<%= link_to new_task_path, class: "text-decoration-none" do %>
  <i class="fa-solid fa-plus"></i> Add a new task
<% end %>
