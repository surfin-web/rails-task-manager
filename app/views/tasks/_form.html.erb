<%= form_with model: task do |form| %>
  <div class="mb-3">
    <%= form.label :title, class: "form-label fw-bold" %>
    <%= form.text_field :title, class: "form-control" %>
  </div>

  <div class="mb-3">
    <%= form.label :details, class: "form-label fw-bold" %>
    <%= form.text_area :details, class: "form-control" %>
  </div>

  <% unless task.new_record? %>
    <div class="form-check mb-3">
      <%= form.check_box :completed, class: "form-check-input" %>
      <%= form.label :completed, class: "form-check-label" %>
    </div>
  <% end %>

  <%= form.submit class: "btn btn-primary" %>
<% end %>
