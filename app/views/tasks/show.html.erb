<h1>
  <% if @task.completed %>
    <i class="fa-regular fa-square-check"></i>
  <% else %>
    <i class="fa-regular fa-square"></i>
  <% end %>
  <%= @task.title %>
</h1>

<p><%= @task.details %></p>

<hr>

<%= link_to edit_task_path(@task), class: "text-decoration-none me-3" do %>
  <i class="fa-solid fa-pen"></i> Edit
<% end %>

<%= link_to tasks_path, class: "text-decoration-none" do %>
  <i class="fa-solid fa-clock-rotate-left"></i> Back to list
<% end %>
